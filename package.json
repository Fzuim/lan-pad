{
  "name": "lanpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "局域网题目协作板：文字 + 代码 + 截图，免登录实时协作",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "crossws": "^0.4.16",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "lowlight": "^3.3.0",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  }
}
