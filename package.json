{
  "name": "lanpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "局域网题目协作板：文字 + 代码 + 截图，免登录实时协作",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"go run ./cmd/lanpad\"",
    "build": "vite build",
    "build:exe": "node scripts/build-exe.mjs",
    "go:build": "node scripts/build-go.mjs",
    "go:run": "go run ./cmd/lanpad",
    "go:test": "go test ./...",
    "start": "go run ./cmd/lanpad",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "crossws": "^0.4.16",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "lowlight": "^3.3.0",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  }
}
